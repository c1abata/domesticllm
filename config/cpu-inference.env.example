# Absolute path to the GGUF model. It must stay outside Git.
MODEL=/home/ale/localdev/cpu-inference/models/MODEL.gguf
MODEL_SHA256=replace-with-sha256-from-sha256sum

# llama.cpp runtime parameters. Set HOST to 0.0.0.0 only on a trusted network.
HOST=0.0.0.0
PORT=8080
CTX_SIZE=32768
THREADS=16
THREADS_BATCH=32
PARALLEL=1
CPU_TARGET=native
GPU_LAYERS=0
# Leave empty to disable API authentication. Set a file path to enable it.
API_KEY_FILE=
ENABLE_WEB_UI=1

# Optional extra llama-server parameters, intentionally empty by default.
EXTRA_ARGS=
