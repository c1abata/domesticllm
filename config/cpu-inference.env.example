# Absolute path to the GGUF model. It must stay outside Git.
MODEL=/home/ale/localdev/cpu-inference/models/MODEL.gguf
MODEL_SHA256=replace-with-sha256-from-sha256sum

# llama.cpp runtime parameters. The requested LAN listener is protected by the
# API key file below; do not remove it when binding to 0.0.0.0.
HOST=0.0.0.0
PORT=8080
CTX_SIZE=32768
THREADS=16
THREADS_BATCH=32
PARALLEL=1
CPU_TARGET=native
GPU_LAYERS=0
API_KEY_FILE=/etc/cpu-inference/api-keys

# Optional extra llama-server parameters, intentionally empty by default.
EXTRA_ARGS=
