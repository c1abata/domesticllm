# Deployment configuration for llmm (10.25.13.22).
# The model is already stored on the server and is never copied into this repo.
MODEL=/srv/local-ai/models/Qwen3-Coder-30B-A3B-Instruct-UD-Q4_K_XL.gguf
MODEL_SHA256=2841aa314d916434860cfb8990347528dcdfe5c350dbcb9d1461dbee88ff2533

# LAN endpoint. Authentication is mandatory through API_KEY_FILE.
HOST=0.0.0.0
PORT=8080
CTX_SIZE=32768
THREADS=16
THREADS_BATCH=32
PARALLEL=1
CPU_TARGET=native
GPU_LAYERS=0
API_KEY_FILE=/etc/cpu-inference/api-keys
EXTRA_ARGS=
