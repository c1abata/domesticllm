{
  "$schema": "https://opencode.ai/config.json",
  "model": "ds4-local/ds4flash",
  "small_model": "ds4-local/ds4flash",
  "shell": "/bin/bash",
  "provider": {
    "ds4-local": {
      "name": "DS4 Intel LAN profile via llama.cpp",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "{env:LOCAL_AI_BASE_URL}",
        "apiKey": "{env:LOCAL_AI_API_KEY}",
        "timeout": 1800000,
        "chunkTimeout": 180000
      },
      "models": {
        "ds4flash": {"name": "DeepSeek V4 Flash DS4 GGUF", "limit": {"context": 100000, "output": 32768}}
      }
    }
  },
  "agent": {
    "plan-local": {
      "description": "Planning agent: read-only analysis, no writes.",
      "mode": "subagent",
      "prompt": "{file:./agents/plan-local.md}",
      "model": "ds4-local/ds4flash",
      "tools": {"read": true, "grep": true, "glob": true, "list": true, "write": false, "edit": false, "bash": false}
    },
    "build-local": {
      "description": "Implementation agent for small controlled patches.",
      "mode": "subagent",
      "prompt": "{file:./agents/build-local.md}",
      "model": "ds4-local/ds4flash",
      "tools": {"read": true, "grep": true, "glob": true, "list": true, "write": "ask", "edit": "ask", "bash": "ask"}
    }
  },
  "compaction": {"auto": true, "prune": true, "reserved": 2048},
  "snapshot": false,
  "watcher": {
    "ignore": [".git/**", "node_modules/**", "dist/**", "build/**", ".venv/**", "venv/**", "__pycache__/**", "*.gguf", "*.bin", "*.sqlite", "*.db"]
  }
}
