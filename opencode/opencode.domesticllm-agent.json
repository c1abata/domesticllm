{
  "$schema": "https://opencode.ai/config.json",
  "model": "ds4/deepseek-v4-flash",
  "small_model": "ds4/deepseek-v4-flash",
  "provider": {
    "ds4": {
      "name": "DwarfStar4 local agent",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://127.0.0.1:8083/v1",
        "apiKey": "{env:LOCAL_AI_API_KEY}",
        "timeout": 1800000,
        "chunkTimeout": 180000
      },
      "models": {
        "deepseek-v4-flash": {"name": "DeepSeek V4 Flash via DwarfStar4", "limit": {"context": 100000, "output": 8192}}
      }
    }
  },
  "permission": {"edit": "ask", "bash": "ask", "webfetch": "deny"},
  "compaction": {"auto": true, "prune": true, "reserved": 2048},
  "snapshot": true,
  "watcher": {"ignore": [".git/**", "node_modules/**", "build/**", ".venv/**", "__pycache__/**", "*.gguf", "*.bin", "*.db"]}
}
