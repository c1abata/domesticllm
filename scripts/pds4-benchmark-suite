#!/usr/bin/env python3
"""Offline deterministic benchmark for the three PDS4 Fast models."""
from __future__ import annotations

import argparse
import json
import pathlib
import subprocess
import sys
import time
import urllib.error
import urllib.request

CASES = {
    "math": "Calcola 37*19+245/5. Rispondi mostrando i passaggi e il risultato finale.",
    "biology": "Spiega in massimo 120 parole come il mitocondrio produce ATP e indica il ruolo dell'ossigeno.",
    "coding": "Scrivi una funzione Python che verifica se una stringa è palindroma ignorando spazi e maiuscole, con un test.",
}


def request(url: str, model: str, category: str, prompt: str, max_tokens: int) -> dict:
    payload = json.dumps({"model": model, "messages": [{"role": "user", "content": prompt}],
                          "max_tokens": max_tokens, "temperature": 0, "stream": True}).encode()
    started = time.monotonic()
    req = urllib.request.Request(url, payload, {"Content-Type": "application/json"})
    text, usage, first = [], {}, None
    status = 0
    try:
        with urllib.request.urlopen(req, timeout=1800) as response:
            status = response.status
            for line in response:
                if not line.startswith(b"data:"):
                    continue
                raw = line[5:].strip()
                if raw == b"[DONE]":
                    continue
                try:
                    event = json.loads(raw)
                except json.JSONDecodeError:
                    continue
                if first is None and event.get("choices"):
                    first = time.monotonic()
                for choice in event.get("choices", []):
                    delta = choice.get("delta", {}).get("content", "")
                    if delta:
                        text.append(delta)
                if event.get("usage"):
                    usage = event["usage"]
        finished = time.monotonic()
        elapsed = finished - started
        return {"model": model, "category": category, "ok": True, "status": status,
                "latency_s": round(elapsed, 4),
                "ttft_s": round((first or finished) - started, 4),
                "prompt_tokens": usage.get("prompt_tokens"),
                "completion_tokens": usage.get("completion_tokens"),
                "tokens_per_s": round((usage.get("completion_tokens", 0) / elapsed), 3) if elapsed else 0,
                "response": "".join(text)}
    except (OSError, urllib.error.HTTPError) as exc:
        return {"model": model, "category": category, "ok": False,
                "status": getattr(exc, "code", 0), "error": str(exc),
                "latency_s": round(time.monotonic() - started, 4)}


def main() -> int:
    parser = argparse.ArgumentParser(prog="pds4-benchmark-suite")
    parser.add_argument("--url", default="http://127.0.0.1:8080/v1/chat/completions")
    parser.add_argument("--models", default="qwen3-coder-q4,dolphin-mistral-24b-q4,dolphin-cyber-8b-q4")
    parser.add_argument("--output", required=True)
    parser.add_argument("--switch", action="store_true")
    parser.add_argument("--max-tokens", type=int, default=256)
    args = parser.parse_args()
    output = pathlib.Path(args.output)
    output.parent.mkdir(parents=True, exist_ok=True)
    models = [item.strip() for item in args.models.split(",") if item.strip()]
    with output.open("a", encoding="utf-8") as stream:
        for model in models:
            if args.switch:
                result = subprocess.run(["/opt/pds4/current/bin/pds4", "lane", "use", "fast", model],
                                        text=True, capture_output=True)
                if result.returncode:
                    record = {"model": model, "ok": False, "phase": "switch", "error": result.stderr[-1000:]}
                    stream.write(json.dumps(record, ensure_ascii=False) + "\n")
                    stream.flush()
                    continue
            for category, prompt in CASES.items():
                record = request(args.url, model, category, prompt, args.max_tokens)
                record["time"] = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
                stream.write(json.dumps(record, ensure_ascii=False) + "\n")
                stream.flush()
                print(json.dumps({k: record.get(k) for k in ("model", "category", "ok", "latency_s", "tokens_per_s")}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
