# Public runtime settings only. Never put secrets in this file.
DS4_HOME=/opt/local-ai
DS4_RELEASES_DIR=/opt/local-ai/releases
DS4_CURRENT=/opt/local-ai/current
DS4_PREVIOUS=/opt/local-ai/previous
DS4_MODEL=/opt/local-ai/models/Huihui-DeepSeek-V4-Flash-BF16-abliterated-ds4-Q2.gguf
DS4_MODEL_SHA256=0abedca3dc470460fd1a5eae8e155c30f14a6584c807674bb9dff3bcf4f9f3d9
DS4_HOST=127.0.0.1
DS4_PORT=8083
DS4_CANARY_PORT=8083
DS4_PRIMARY_PORT=8082
DS4_FALLBACK_PORT=8084
DS4_CONTEXT=100000
DS4_TOKENS=4096
DS4_THREADS=16
DS4_POWER=100
# The locked DS4 runtime supports CUDA SSD streaming. Keep one A4500 dedicated
# to DS4 and reserve the second GPU for the small fast lane after acceptance.
DS4_RUNTIME_MODE=ssd-streaming
DS4_SSD_STREAMING_CACHE_EXPERTS=4GB
DS4_MIN_DEVICE_VRAM_MIB=16000
DS4_KV_DISK_DIR=/var/cache/local-ai/ds4/kv
DS4_KV_DISK_SPACE_MB=8192
DS4_HEALTH_ATTEMPTS=90
DS4_HEALTH_INTERVAL=2
CUDA_VISIBLE_DEVICES=0
LLAMA_PRIMARY_UNIT=local-ai-ds4-nvidia.service
LLAMA_FALLBACK_UNIT=local-ai-llama-fallback.service
