LOCAL_AI_HOME=/opt/local-ai
LOCAL_AI_MODEL=/opt/local-ai/models/main.gguf
LOCAL_AI_HOST=0.0.0.0
LOCAL_AI_PORT=8080
LOCAL_AI_API_KEY_FILE=/etc/local-ai.key
LOCAL_AI_THREADS=4
LOCAL_AI_THREADS_BATCH=4
LOCAL_AI_CTX=4096
LOCAL_AI_PREDICT=1536
LOCAL_AI_BATCH=256
LOCAL_AI_UBATCH=64
LOCAL_AI_PARALLEL=1
LOCAL_AI_SLOTS=1
LOCAL_AI_SLOT_SAVE_PATH=/var/cache/local-ai/slots
LOCAL_AI_CACHE_TYPE_K=q8_0
LOCAL_AI_CACHE_TYPE_V=q8_0
LOCAL_AI_CACHE_REUSE=256
LOCAL_AI_KEEP=-1
LOCAL_AI_EXTRA_ARGS=
