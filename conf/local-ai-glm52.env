LOCAL_AI_HOME=/opt/local-ai
LOCAL_AI_MODEL=/opt/local-ai/models/unsloth__GLM-5.2-GGUF/UD-IQ2_XXS/GLM-5.2-UD-IQ2_XXS-00001-of-00006.gguf
LOCAL_AI_REQUEST_MODEL=glm-5.2-iq2_xxs
LOCAL_AI_HOST=0.0.0.0
LOCAL_AI_PORT=8083
LOCAL_AI_API_KEY_FILE=/etc/local-ai-glm52.key
LOCAL_AI_THREADS=16
LOCAL_AI_THREADS_BATCH=16
LOCAL_AI_CTX=8192
LOCAL_AI_PREDICT=2048
LOCAL_AI_BATCH=128
LOCAL_AI_UBATCH=32
LOCAL_AI_PARALLEL=1
LOCAL_AI_SLOTS=1
LOCAL_AI_SLOT_SAVE_PATH=/var/cache/local-ai/glm52-slots
LOCAL_AI_CACHE_TYPE_K=q4_0
LOCAL_AI_CACHE_TYPE_V=q4_0
LOCAL_AI_CACHE_REUSE=512
LOCAL_AI_KEEP=-1
LOCAL_AI_EXTRA_ARGS=
