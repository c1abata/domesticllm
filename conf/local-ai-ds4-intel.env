LOCAL_AI_HOME=/opt/local-ai
LOCAL_AI_MODEL=/opt/local-ai/models/ds4flash.gguf
LOCAL_AI_REQUEST_MODEL=ds4flash
LOCAL_AI_HOST=127.0.0.1
LOCAL_AI_PORT=8081
LOCAL_AI_API_KEY_FILE=/etc/local-ai-ds4-intel.key
LOCAL_AI_THREADS=8
LOCAL_AI_THREADS_BATCH=8
LOCAL_AI_CTX=8192
LOCAL_AI_PREDICT=1536
LOCAL_AI_BATCH=128
LOCAL_AI_UBATCH=32
LOCAL_AI_PARALLEL=1
LOCAL_AI_SLOTS=1
LOCAL_AI_SLOT_SAVE_PATH=/var/cache/local-ai/ds4-slots
LOCAL_AI_CACHE_TYPE_K=q8_0
LOCAL_AI_CACHE_TYPE_V=q8_0
LOCAL_AI_CACHE_REUSE=512
LOCAL_AI_KEEP=-1
LOCAL_AI_EXTRA_ARGS=
