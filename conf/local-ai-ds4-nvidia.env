LOCAL_AI_HOME=/opt/local-ai
LOCAL_AI_MODEL=/opt/local-ai/models/ds4flash.gguf
LOCAL_AI_REQUEST_MODEL=ds4flash
LOCAL_AI_HOST=127.0.0.1
LOCAL_AI_PORT=8082
LOCAL_AI_API_KEY_FILE=/etc/local-ai-ds4-nvidia.key
LOCAL_AI_THREADS=24
LOCAL_AI_THREADS_BATCH=24
LOCAL_AI_CTX=8192
LOCAL_AI_PREDICT=1536
LOCAL_AI_BATCH=256
LOCAL_AI_UBATCH=64
LOCAL_AI_PARALLEL=1
LOCAL_AI_SLOTS=1
LOCAL_AI_SLOT_SAVE_PATH=/var/cache/local-ai/ds4-slots
LOCAL_AI_CACHE_TYPE_K=q4_0
LOCAL_AI_CACHE_TYPE_V=q4_0
LOCAL_AI_CACHE_REUSE=512
LOCAL_AI_KEEP=-1
LOCAL_AI_N_GPU_LAYERS=16
LOCAL_AI_SPLIT_MODE=layer
LOCAL_AI_MAIN_GPU=0
CUDA_VISIBLE_DEVICES=0,1
CUDA_SCALE_LAUNCH_QUEUES=4x
GGML_CUDA_ENABLE_UNIFIED_MEMORY=0
GGML_CUDA_P2P=0
LOCAL_AI_EXTRA_ARGS=
