[Unit]
Description=PDS4 Fast canary (%i)
Conflicts=pds4-fast@%i.service
After=local-fs.target

[Service]
Type=simple
User=pds4-fast
Group=pds4-models
EnvironmentFile=/etc/pds4/gpus.conf
EnvironmentFile=/run/pds4/fast-canary.env
Environment=LD_LIBRARY_PATH=/opt/pds4/current/lib
ExecStart=/usr/bin/env CUDA_VISIBLE_DEVICES=${PDS4_FAST_GPU} /opt/pds4/current/bin/llama-server --host 127.0.0.1 --port 8086 --model ${PDS4_FAST_MODEL} --alias ${PDS4_FAST_ALIAS} --ctx-size ${PDS4_FAST_CONTEXT} --n-predict 512 --n-gpu-layers 999 --split-mode none --main-gpu 0 --parallel 1 --no-ui
MemoryMax=32G
SyslogIdentifier=pds4-fast-canary-%i
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
DevicePolicy=closed
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
ReadOnlyPaths=/opt/pds4 /srv/pds4 /run/pds4/fast-canary.env
ReadWritePaths=/var/cache/pds4/kv/fast-canary
