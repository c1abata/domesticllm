[Unit]
Description=Local CPU GGUF inference server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ale
Group=ale
WorkingDirectory=/home/ale/cpu-inference
Environment=CPU_INFERENCE_CONFIG=/home/ale/cpu-inference/config/llmm.env
ExecStart=/home/ale/cpu-inference/scripts/run-server.sh
Restart=on-failure
RestartSec=5
TimeoutStartSec=20min
TimeoutStopSec=5min
MemoryMax=110G
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
ReadOnlyPaths=/home/ale/cpu-inference /srv/local-ai/models
ReadWritePaths=/var/lib/cpu-inference
StateDirectory=cpu-inference

[Install]
WantedBy=multi-user.target
