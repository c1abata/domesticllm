# Store the real values in ~/.hermes/.env with mode 0600.
DOMESTICLLM_API_KEY=replace-with-the-domesticllm-gateway-key
TELEGRAM_BOT_TOKEN=replace-with-the-token-from-botfather
TELEGRAM_ALLOWED_USERS=replace-with-your-numeric-telegram-user-id

# Local DS4 prefill can legitimately take minutes for a large first prompt.
HERMES_STREAM_READ_TIMEOUT=1800
